{
  "name": "@johpaz/hive-sdk",
  "version": "0.6.0",
  "private": false,
  "description": "Hive SDK — The Agent Harness SDK. Build, deploy, and scale AI agent applications with multi-channel support, context engineering, and swarm orchestration.",
  "license": "MIT",
  "homepage": "https://github.com/johpaz/hive-sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/johpaz/hive-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/johpaz/hive-sdk/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "llm",
    "harness",
    "context-engineering",
    "fts5",
    "swarm",
    "ace",
    "bun",
    "langchain-alternative",
    "multi-channel",
    "gateway"
  ],
  "main": "./packages/core/src/index.ts",
  "types": "./packages/core/src/index.ts",
  "exports": {
    ".": "./packages/core/src/index.ts",
    "./agent": "./packages/core/src/agent/index.ts",
    "./agent/providers": "./packages/core/src/agent/providers/index.ts",
    "./tools": "./packages/core/src/tools/index.ts",
    "./skills": "./packages/core/src/skills/index.ts",
    "./storage": "./packages/core/src/storage/index.ts",
    "./services": "./packages/core/src/services/index.ts",
    "./hooks": "./packages/core/src/hooks/index.ts",
    "./images": "./packages/core/src/images/index.ts",
    "./sessions": "./packages/core/src/sessions/index.ts",
    "./models": "./packages/core/src/models/index.ts",
    "./swarm": "./packages/core/src/swarm/index.ts",
    "./swarm/strategies": "./packages/core/src/swarm/strategies/index.ts",
    "./swarm/presets": "./packages/core/src/swarm/presets/index.ts",
    "./scheduler": "./packages/core/src/scheduler/index.ts",
    "./workers": "./packages/core/src/workers/index.ts",
    "./events": "./packages/core/src/events/index.ts",
    "./resilience": "./packages/core/src/resilience/index.ts",
    "./tool-runtime": "./packages/core/src/tool-runtime/index.ts",
    "./channels": "./packages/core/src/channels/index.ts",
    "./voice": "./packages/core/src/voice/index.ts",
    "./artifacts": "./packages/core/src/artifacts/index.ts",
    "./ethics": "./packages/core/src/ethics/index.ts",
    "./canvas": "./packages/core/src/canvas/index.ts",
    "./config": "./packages/core/src/config/index.ts",
    "./mcp": "./packages/core/src/mcp/index.ts",
    "./mcp/transports": "./packages/core/src/mcp/transports/index.ts",
    "./memory": "./packages/core/src/memory/index.ts",
    "./multimodal": "./packages/core/src/multimodal/index.ts",
    "./security": "./packages/core/src/security/index.ts",
    "./state": "./packages/core/src/state/index.ts",
    "./utils": "./packages/core/src/utils/index.ts",
    "./gateway": "./packages/core/src/gateway/index.ts",
    "./api": "./packages/core/src/api/index.ts",
    "./harness": "./packages/core/src/harness/index.ts",
    "./package.json": "./package.json"
  },
  "bin": {
    "hives": "./packages/cli/bin/hives"
  },
  "files": [
    "packages/core/src",
    "packages/cli/bin",
    "packages/cli/src",
    "packages/cli/templates",
    "!packages/**/*.test.ts",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs",
    "LICENSE"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "packages/core",
    "packages/cli"
  ],
  "scripts": {
    "build": "bun run typecheck",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "skills:bundle": "bun scripts/generate-skill-bundle.ts",
    "version:set": "bun scripts/bump-version.ts",
    "release": "bun scripts/bump-version.ts --push",
    "prepublishOnly": "bun run typecheck && bun test",
    "drift": "bun scripts/check-drift.ts",
    "lint": "biome lint --error-on-warnings"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@google/genai": "^2.27.0",
    "@johpaz/hive-db": "^0.5.1",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@slack/bolt": "^5.1.0",
    "@whiskeysockets/baileys": "7.0.0-rc14",
    "discord.js": "^14.27.0",
    "docx": "^9.8.1",
    "grammy": "^1.46.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "ollama": "^0.6.4",
    "openai": "^7.27.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299",
    "qrcode-terminal": "^0.12.0",
    "toon-format-parser": "^1.1.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "async-mutex": "^0.5.0",
    "typescript": "7.0.2",
    "zod": "^4.6.5"
  }
}
